# ---------- Ambiente ----------
APP_ENV=development
# Obrigatório em produção. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300

# ---------- Dados ----------
# Local sem Docker usa SQLite automaticamente (var/goops.db). No Docker, o compose define o PostgreSQL.
# DATABASE_URL=postgresql://goops:SENHA@localhost:5432/goops
POSTGRES_PASSWORD=
# LAKEHOUSE_PATH=./var/lakehouse
# auto | parquet | csv
STORAGE_FORMAT=auto

# ---------- Demonstração ----------
DEMO_MODE=true
# carrega a demo na 1ª inicialização se não houver datasets
AUTO_LOAD_DEMO=true
# Senha dos usuários *@goops.local de DEMONSTRAÇÃO. Se vazio, uma senha aleatória é gerada em var/demo_credentials.txt
DEMO_ADMIN_PASSWORD=

# ---------- Execução de ações ----------
# única opção implementada nesta versão
ACTION_EXECUTION_MODE=simulated

# ---------- Intelligent Cost Routing (opcional) ----------
# RECOMENDADO: configure modelos, chaves, preços e limites na tela Settings › Modelos e chaves.
# Os valores salvos na interface (chaves cifradas no banco) têm precedência sobre estas variáveis,
# que servem apenas como padrão inicial. Provedores: none | anthropic | openai_compatible.
LLM_SMALL_PROVIDER=none
LLM_SMALL_MODEL=
LLM_SMALL_ALIAS=JEF
LLM_ECONOMY_PROVIDER=none
LLM_ECONOMY_MODEL=
LLM_ADVANCED_PROVIDER=none
LLM_ADVANCED_MODEL=
# AI Proxy do Gogroup (evento): token gw-tok-… — ou cadastre em Settings › Modelos e chaves (cifrado)
AI_PROXY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_API_KEY=
# Modelos locais (sem custo): rode `ollama serve` e `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
# Preços por modelo (USD por milhão de tokens), ex.: {"nome-do-modelo": {"input_per_mtok": 0, "output_per_mtok": 0}}
MODEL_PRICING_JSON=
COST_LIMIT_PER_RUN_USD=0.50
COST_LIMIT_DAILY_USD=5.00

# ---------- Monitor Agent (padrões; editáveis em Settings › Monitor, agendador e retenção) ----------
MONITOR_NPS_DROP_POINTS=8
MONITOR_MIN_SAMPLE=30
MONITOR_CARRIER_LATE_INCREASE_PP=15
MONITOR_PRODUCT_DETRACTOR_RATIO=1.8
AUTO_INVESTIGATE=true

# ---------- Credenciais de fontes reais (referenciadas por *_env na config da fonte) ----------
# ORDERS_API_TOKEN=
# NPS_API_TOKEN=
# DELIVERIES_API_TOKEN=

# ---------- Infraestrutura ----------
# liga o executor do agendador neste processo (jobs/intervalos são definidos na tela)
SCHEDULER_ENABLED=true
# memory | database (compartilhado entre instâncias)
RATE_LIMIT_BACKEND=memory
# Tentativas de login por minuto por IP
LOGIN_RATE_LIMIT_PER_MINUTE=10
# IPs de proxies confiáveis para ler X-Forwarded-For (vazio = loopback/rede privada, ex.: Next.js e Docker)
# TRUSTED_PROXIES=
# Conector HTTP: nomes extras de variáveis de credencial aceitas e hosts internos liberados (separados por vírgula)
# SOURCE_CREDENTIAL_ENV_ALLOWLIST=
# SOURCE_ALLOWED_PRIVATE_HOSTS=

# ---------- Canal do time (opcional; também configurável em Settings › Canal do time) ----------
# Bot do Telegram (@BotFather) para avisos e aprovação por botão
# TELEGRAM_BOT_TOKEN=
# Incoming webhook do Slack (só avisos)
# SLACK_WEBHOOK_URL=
